    "next-themes": "^0.4.6",
    "pigeon-maps": "^0.22.1",
    "qrcode.react": "^4.2.0",
    "raviger": "^5.3.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^5.5.7",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-intersection-observer": "^10.0.3",
    "react-pdf": "^10.4.1",
    "react-phone-number-input": "^3.4.17",
    "react-resizable-panels": "^4.11.2",
    "react-webcam": "^7.2.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "use-keyboard-shortcut": "^1.1.6",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-i18next-no-undefined-translation-keys": "^3.4.0",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "6.17.1",
    "lint-staged": "^17.0.6",
    "magic-string": "^0.30.21",
    "marked": "^18.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "snyk": "^1.1305.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.14.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "latest",
    "@esbuild/linux-x64": "latest",
    "@rollup/rollup-linux-arm64-gnu": "4.60",
    "@rollup/rollup-linux-x64-gnu": "4.60"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write --ignore-unknown --plugin prettier-plugin-tailwindcss --plugin prettier-plugin-organize-imports",
      "cross-env PRE_COMMIT=true eslint --fix --config eslint.config.mjs",
      "git update-index --again"
    ],
    "public/locale/*.json": [
      "npm run sort-locales"
    ]
  }
}
