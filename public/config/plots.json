{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Facility Print Configuration",
  "description": "Configuration schema for print layouts across document types. The top-level 'default' profile applies to all documents unless overridden by a document-specific profile under 'documentTypes'.",
  "type": "object",
  "required": ["default"],
  "additionalProperties": false,
  "properties": {
    "default": {
      "$ref": "#/$defs/printProfile",
      "description": "Default print profile applied to all document types unless overridden."
    },
    "documentTypes": {
      "type": "object",
      "description": "Per-document-type overrides. Each key is a document type identifier. Values are partial print profiles that are merged on top of the default.",
      "additionalProperties": {
        "$ref": "#/$defs/printProfile"
      },
      "propertyNames": {
        "enum": [
          "appointment",
          "invoice",
          "prescription",
          "discharge_summary",
          "lab_report",
          "consent_form",
          "dispense_order",
          "request_order",
          "delivery_order"
        ]
      }
    }
  },

  "$defs": {
    "printProfile": {
      "type": "object",
      "description": "A complete print profile defining page, branding, layout, and watermark settings.",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "object",
          "description": "Page dimensions, orientation, and margin configuration.",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "enum": ["A4", "A5", "Letter", "Legal"],
              "default": "A4",
              "description": "Paper size for the printed document."
            },
            "orientation": {
              "type": "string",
              "enum": ["portrait", "landscape"],
              "default": "portrait",
              "description": "Page orientation."
            },
            "margin": {
              "type": "object",
              "description": "Page margins in millimeters.",
              "additionalProperties": false,
              "required": ["top", "bottom", "left", "right"],
              "properties": {
                "top": {
                  "type": "number",
                  "minimum": 0,
                  "default": 10,
                  "description": "Top margin in mm."
                },
                "bottom": {
                  "type": "number",
                  "minimum": 0,
                  "default": 10,
                  "description": "Bottom margin in mm."
                },
                "left": {
                  "type": "number",
                  "minimum": 0,
                  "default": 10,
                  "description": "Left margin in mm."
                },
                "right": {
                  "type": "number",
                  "minimum": 0,
                  "default": 10,
                  "description": "Right margin in mm."
                }
              }
            }
          }
        },

        "branding": {
          "type": "object",
          "description": "Branding assets for the printed document (logo, header/footer images, facility info).",
          "additionalProperties": false,
          "properties": {
            "logo": {
              "type": "object",
              "description": "Facility logo displayed in the document header.",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL of the logo image."
                },
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "description": "Logo width in pixels."
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "description": "Logo height in pixels."
                },
                "alignment": {
                  "type": "string",
                  "enum": ["left", "center", "right"],
                  "default": "left",
                  "description": "Horizontal alignment of the logo within the header."
                }
              },
              "required": ["url"]
            },
            "headerImage": {
              "type": "object",
              "description": "Full-width header image replacing the default facility name + logo header.",
              "additionalProperties": false,
              "required": ["url"],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL of the header image."
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "description": "Header image height in pixels."
                }
              }
            },
            "footerImage": {
              "type": "object",
              "description": "Full-width footer image rendered at the bottom of each page.",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL of the footer image."
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "description": "Footer image height in pixels."
                }
              },
              "required": ["url"]
            },
            "facilityInfo": {
              "type": "object",
              "description": "Facility name and address displayed in the default header when no headerImage is provided.",
              "additionalProperties": false,
              "properties": {
                "showName": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to display the facility name."
                },
                "showAddress": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether to display the facility address."
                }
              }
            }
          }
        },

        "layout": {
          "type": "object",
          "description": "Layout and typography settings for the printed document.",
          "additionalProperties": false,
          "properties": {
            "fontSize": {
              "type": "number",
              "minimum": 6,
              "maximum": 24,
              "default": 12,
              "description": "Base font size in points."
            },
            "fontFamily": {
              "type": "string",
              "default": "sans-serif",
              "description": "CSS font-family for the printed document."
            },
            "lineHeight": {
              "type": "number",
              "minimum": 1,
              "maximum": 3,
              "default": 1.5,
              "description": "Line height multiplier for body text."
            },
            "color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "default": "#000000",
              "description": "Primary text color as a hex value."
            }
          }
        },

        "watermark": {
          "type": "object",
          "description": "Watermark overlay rendered on each page (e.g. DRAFT, CANCELLED).",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether to display the watermark."
            },
            "text": {
              "type": "string",
              "maxLength": 50,
              "description": "Watermark text content."
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.1,
              "description": "Watermark opacity (0 = transparent, 1 = opaque)."
            },
            "rotation": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "default": -45,
              "description": "Watermark rotation in degrees."
            },
            "color": {
              "type": "string",
              "enum": ["red", "gray", "yellow"],
              "default": "gray",
              "description": "Watermark color preset."
            }
          },
          "if": {
            "properties": { "enabled": { "const": true } }
          },
          "then": {
            "required": ["text"]
          }
        },

        "footer": {
          "type": "object",
          "description": "Footer content settings for printed pages.",
          "additionalProperties": false,
          "properties": {
            "showPreparedBy": {
              "type": "boolean",
              "default": true,
              "description": "Show the name of the user who prepared the document."
            },
            "showPrintedBy": {
              "type": "boolean",
              "default": true,
              "description": "Show the name of the user who printed the document."
            },
            "showGeneratedAt": {
              "type": "boolean",
              "default": true,
              "description": "Show the timestamp when the document was generated."
            },
            "dateFormat": {
              "type": "string",
              "default": "dd/MM/yyyy HH:mm",
              "description": "Date format string (date-fns compatible) for timestamps."
            }
          }
        }
      }
    }
  }
}