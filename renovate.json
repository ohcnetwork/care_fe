{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "@ohcnetwork/care-fe-code-reviewers"
  ],
  "automergeStrategy": "squash",
  "automergeType": "pr",
  "schedule": [
    "* 0-3 * * 1"
  ],
  "packageRules": [
    {
      "groupName": "all dependencies (patch)",
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "@mdxeditor/editor bundles its own lexical. Our direct lexical packages must stay on the same version, or the app loads two lexical copies and the rich text editor crashes. Bump them by hand together with @mdxeditor/editor.",
      "matchPackageNames": [
        "lexical",
        "@lexical/**"
      ],
      "enabled": false
    }
  ]
}