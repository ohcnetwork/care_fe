{
  "compilerOptions": {
    // Using ES2020 target for Chrome 83+ compatibility (Issue #14887)
    // Polyfills for ES2021+ features are provided via @vitejs/plugin-legacy
    "target": "ES2020",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@core/*": [
        "src/*"
      ],
      "@careConfig": [
        "./care.config.ts"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/remote-modules.d.ts"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "care.config.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "plugins/**/*.ts"
  ]
}